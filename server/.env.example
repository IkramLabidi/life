# Server configuration
PORT=5000

# MongoDB connection string.
# Leave empty to use a temporary in-memory MongoDB (great for quick demos —
# data is NOT persisted between restarts).
# For persistence use a local MongoDB or MongoDB Atlas:
#   Local:  mongodb://127.0.0.1:27017/lifeos
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeos
MONGODB_URI=

# JWT signing secret — change this to a long random string.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# Allowed origin for CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
